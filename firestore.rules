rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Junto Select Introduction is reserved for people 35 and over.
    // `bd` may be null (not answered yet) or a Timestamp (birth date).
    // Someone born on or before "today minus 35 years" is eligible.
    // This is real server-side enforcement: even a request built by hand
    // in devtools against the Firestore SDK, bypassing our UI entirely,
    // is rejected here.
    function birthDateIsEligible(bd) {
      return bd == null ||
        bd <= timestamp.date(
          request.time.year() - 35,
          request.time.month(),
          request.time.day()
        );
    }

    // Identity doc created on first sign-in. Owner-only.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Step 1 profile ("About me"). Owner-only for now — nobody else can
    // read a profile yet, since matching doesn't exist. Later stages will
    // add narrow, explicit read access for a legitimate match, never a
    // blanket "any signed-in user" rule.
    // `meta.searchStatus` (billing entitlement — receives own proposals or
    // not) must never move on a client-submitted write: only the Stripe
    // webhook sets it, via the Admin SDK, which bypasses this rule
    // entirely. Without this, a signed-in user could set their own
    // `meta.searchStatus: "active_search"` by hand-building a Firestore
    // SDK call and skip paying altogether, since `update` below otherwise
    // allows arbitrary changes to the rest of the document. There is no
    // legitimate client write path for this field today (it's only ever
    // set to its default "passive" at profile *creation*, never updated
    // from the client afterward), so this closes a real gap at zero cost
    // to existing behavior.
    //
    // `meta.profileStatus` (matching eligibility) is NOT locked here even
    // though it has the same shape of risk — see README "Known
    // limitation, now actually live" — because, unlike searchStatus, it
    // genuinely IS written by the client SDK today, from three legitimate
    // in-product flows (finishing photos, preferences, or the AI
    // presentation step each recompute and save it). Locking it the same
    // way would break onboarding itself, which is explicitly out of scope
    // to touch in this change. Flagged again in the final report as a
    // pre-existing gap, not introduced or worsened here.
    function searchStatusUnchanged() {
      return request.resource.data.meta.searchStatus == resource.data.meta.searchStatus;
    }

    match /profiles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && birthDateIsEligible(request.resource.data.private.birthDate);
      allow update: if request.auth != null
        && request.auth.uid == uid
        && birthDateIsEligible(request.resource.data.private.birthDate)
        && searchStatusUnchanged();
      allow delete: if false;
    }

    // `billing/{uid}` — Stripe-derived membership/entitlement mirror.
    // Stripe itself is the source of truth; this is a read-optimized cache
    // written exclusively by server routes (checkout/portal session
    // creation, the webhook) using the Admin SDK, which bypasses this rule
    // entirely. The owner may read their own billing state; nobody can
    // write it from a client, same pattern as `proposals`/`invitations`.
    match /billing/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // processedStripeEvents/{eventId}: webhook idempotency bookkeeping
    // only, Admin-SDK-only, no legitimate client read or write path — left
    // uncovered on purpose and falls through to the default-deny below.

    // A member-facing proposal from the V1 matching engine. Recipient-only
    // read (matched against the uid the proposal was actually generated
    // for, snapshotted at creation time — see src/lib/matching/engine.ts).
    // Never client-writable: every proposal, and every decision recorded
    // on one, is written by the Admin SDK only (server-side, service
    // account credentials, which bypass these rules entirely) — this rule
    // only ever governs a browser/client SDK request.
    match /proposals/{proposalId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.recipientUid;
      allow write: if false;
    }

    // Stage 2 of a proposal: the free invitation sent to the originally
    // selected candidate once the active/paid member says Interested.
    // Readable only by the invited person (never the inviter — they only
    // learn the outcome once/if it becomes a mutual introduction below).
    match /invitations/{invitationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.recipientUid;
      allow write: if false;
    }

    // A confirmed mutual introduction — both original parties may read it.
    // No contact info lives here yet; contactRevealedAt is reserved for a
    // future flow that doesn't exist.
    match /introductions/{introductionId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uidA || request.auth.uid == resource.data.uidB);
      allow write: if false;
    }

    // matchingCycles, memberRuns (subcollection), pairHistory, people,
    // duplicateCandidates: all Admin-SDK-only, server-side matching
    // infrastructure with no legitimate client read or write path — these
    // are intentionally left uncovered by an explicit rule above and fall
    // through to the default-deny below.

    // Default-deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
