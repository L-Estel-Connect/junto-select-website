rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Junto Select Introduction is reserved for people 35 and over.
    // `bd` may be null (not answered yet) or a Timestamp (birth date).
    // Someone born on or before "today minus 35 years" is eligible.
    // This is real server-side enforcement: even a request built by hand
    // in devtools against the Firestore SDK, bypassing our UI entirely,
    // is rejected here.
    function birthDateIsEligible(bd) {
      return bd == null ||
        bd <= timestamp.date(
          request.time.year() - 35,
          request.time.month(),
          request.time.day()
        );
    }

    // Identity doc created on first sign-in. Owner-only.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Step 1 profile ("About me"). Owner-only for now — nobody else can
    // read a profile yet, since matching doesn't exist. Later stages will
    // add narrow, explicit read access for a legitimate match, never a
    // blanket "any signed-in user" rule.
    // `meta.searchStatus` (billing entitlement — receives own proposals or
    // not) must never move on a client-submitted write: only the Stripe
    // webhook sets it, via the Admin SDK, which bypasses this rule
    // entirely. Without this, a signed-in user could set their own
    // `meta.searchStatus: "active_search"` by hand-building a Firestore
    // SDK call and skip paying altogether, since `update` below otherwise
    // allows arbitrary changes to the rest of the document. There is no
    // legitimate client write path for this field today (it's only ever
    // set to its default "passive" at profile *creation*, never updated
    // from the client afterward), so this closes a real gap at zero cost
    // to existing behavior.
    //
    // `meta.profileStatus` (matching eligibility) is NOT locked here even
    // though it has the same shape of risk — see README "Known
    // limitation, now actually live" — because, unlike searchStatus, it
    // genuinely IS written by the client SDK today, from three legitimate
    // in-product flows (finishing photos, preferences, or the AI
    // presentation step each recompute and save it). Locking it the same
    // way would break onboarding itself, which is explicitly out of scope
    // to touch in this change. Flagged again in the final report as a
    // pre-existing gap, not introduced or worsened here.
    // `meta.matchingAnchorAt`/`matchingSubscriptionId`/
    // `matchingPeriodsProcessed`/`nextMatchingDueAt` (added for the
    // per-member-anniversary matching model — see
    // src/lib/matching/dueScheduler.ts) carry the exact same risk as
    // `searchStatus` above and get the identical treatment: only the
    // Stripe webhook (Admin SDK) ever sets them. Without this, a
    // signed-in user could set their own `nextMatchingDueAt` into the
    // past to force themselves into extra matching periods, or forge
    // `matchingPeriodsProcessed` down to make an already-used period
    // look unused. Same known limitation as searchStatus: this guards
    // `update` only, not `create` — a hand-built create request could in
    // principle set these at document-creation time, but the real
    // onboarding flow never does, and locking `create` too would need
    // touching the same profile-creation path this change doesn't.
    //
    // Uses `.get(key, default)`, NOT plain dot access, for ALL FIVE fields,
    // `searchStatus` included. `searchStatus` was originally assumed
    // "always present since profile creation" and read with plain dot
    // access — but any profile document created before this field existed
    // in the schema (see git history: it predates the matching engine
    // entirely) genuinely has no `meta.searchStatus` key, and a client
    // partial-update (`updateDoc`) to ANY other field on such a document
    // never backfills it, since nothing but the original create call ever
    // wrote it. Plain dot access on that missing key is a rules EVALUATION
    // ERROR, which denies the WHOLE update — with no useful message beyond
    // a generic permission-denied — breaking every subsequent edit to that
    // profile (onboarding, preferences, photos, presentation, and the
    // "Sobre ti" self-edit section alike) forever. Confirmed via the
    // emulator suite: a seeded profile missing this key is rejected with
    // "Property searchStatus is undefined on object" for every update,
    // however innocuous. `.get(key, 'passive')` defaults to the same value
    // `getOrCreateProfile`/`withProfileDefaults` already treat as this
    // field's canonical default, so a legitimate write is never newly
    // permitted to actually CHANGE `searchStatus` — a document already
    // missing the key stays missing it (both sides read the same default,
    // so the equality check still holds); this only stops the crash.
    function matchingStateUnchanged() {
      return request.resource.data.meta.get('searchStatus', 'passive') == resource.data.meta.get('searchStatus', 'passive')
        && request.resource.data.meta.get('matchingAnchorAt', null) == resource.data.meta.get('matchingAnchorAt', null)
        && request.resource.data.meta.get('matchingSubscriptionId', null) == resource.data.meta.get('matchingSubscriptionId', null)
        && request.resource.data.meta.get('matchingPeriodsProcessed', null) == resource.data.meta.get('matchingPeriodsProcessed', null)
        && request.resource.data.meta.get('nextMatchingDueAt', null) == resource.data.meta.get('nextMatchingDueAt', null);
    }

    // Legacy-contact activation (see src/lib/legacyImport/) — UNLIKE
    // `searchStatus` and friends above, `pendingLegacyActivation` is
    // explicitly, deliberately locked against ANY client write, not just
    // left as a documented pre-existing gap the way `profileStatus`
    // still is: the whole point of this flag is that clearing it must be
    // impossible except through the dedicated, independently-re-verifying
    // `/api/legacy/activate` server endpoint (claim.ts
    // `activateLegacyProfile`), which uses the Admin SDK and so bypasses
    // this rule file entirely. A client can never flip it true either
    // (not that doing so would help them — see `legacyImportId`, the
    // profile's own onboarding requirements are unaffected). `create` is
    // deliberately not covered here, same precedent as
    // `matchingStateUnchanged` above: the real profile-creation paths
    // (`getOrCreateProfile` for Path A, `claimLegacyContact` for Path B)
    // both run entirely server/client-SDK-side under their own control at
    // creation time, and there is no exploit in a hand-built `create`
    // setting these fields since neither one alone grants matching
    // eligibility.
    function legacyActivationStateUnchanged() {
      return request.resource.data.meta.get('pendingLegacyActivation', false) == resource.data.meta.get('pendingLegacyActivation', false)
        && request.resource.data.meta.get('legacyImportId', null) == resource.data.meta.get('legacyImportId', null);
    }

    match /profiles/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && birthDateIsEligible(request.resource.data.private.birthDate);
      allow update: if request.auth != null
        && request.auth.uid == uid
        && birthDateIsEligible(request.resource.data.private.birthDate)
        && matchingStateUnchanged()
        && legacyActivationStateUnchanged();
      allow delete: if false;
    }

    // `billing/{uid}` — Stripe-derived membership/entitlement mirror.
    // Stripe itself is the source of truth; this is a read-optimized cache
    // written exclusively by server routes (checkout/portal session
    // creation, the webhook) using the Admin SDK, which bypasses this rule
    // entirely. The owner may read their own billing state; nobody can
    // write it from a client, same pattern as `proposals`/`invitations`.
    match /billing/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // processedStripeEvents/{eventId}: webhook idempotency bookkeeping
    // only, Admin-SDK-only, no legitimate client read or write path — left
    // uncovered on purpose and falls through to the default-deny below.

    // `eventBenefits/{cycleKey}` — one immutable-once-settled record per
    // monthly Ticket Tailor event-benefit cycle (see
    // src/lib/eventBenefits/lifecycle.ts). Owner-only read, same pattern
    // as `proposals`/`introductions`; never client-writable — a member
    // can never create a benefit for themself, change its percentage,
    // manufacture a cycle key, or mark one active/invalidated. Every
    // write is Admin SDK only (the webhook, the due-scan scheduler).
    match /eventBenefits/{cycleKey} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // eligibleTicketTailorEvents/{ticketTailorEventId}: admin-managed
    // configuration of which Ticket Tailor events/ticket types
    // participate in the member benefit — Admin-SDK-only (the admin
    // dashboard's session-authorized API routes), no legitimate client
    // read or write path at all — left uncovered on purpose, same
    // treatment as `matchingCycles`/`legacyImports` above, and falls
    // through to the default-deny below.

    // A member-facing proposal from the V1 matching engine. Recipient-only
    // read (matched against the uid the proposal was actually generated
    // for, snapshotted at creation time — see src/lib/matching/engine.ts).
    // Never client-writable: every proposal, and every decision recorded
    // on one, is written by the Admin SDK only (server-side, service
    // account credentials, which bypass these rules entirely) — this rule
    // only ever governs a browser/client SDK request.
    match /proposals/{proposalId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.recipientUid;
      allow write: if false;
    }

    // Stage 2 of a proposal: the free invitation sent to the originally
    // selected candidate once the active/paid member says Interested.
    // Readable only by the invited person (never the inviter — they only
    // learn the outcome once/if it becomes a mutual introduction below).
    match /invitations/{invitationId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.recipientUid;
      allow write: if false;
    }

    // A confirmed mutual introduction — both original parties may read it.
    // No contact info lives here yet; contactRevealedAt is reserved for a
    // future flow that doesn't exist.
    match /introductions/{introductionId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.uidA || request.auth.uid == resource.data.uidB);
      allow write: if false;
    }

    // matchingCycles, memberRuns (subcollection), pairHistory, people,
    // duplicateCandidates: all Admin-SDK-only, server-side matching
    // infrastructure with no legitimate client read or write path — these
    // are intentionally left uncovered by an explicit rule above and fall
    // through to the default-deny below.

    // legacyImports/{id}: legacy-contact activation records (see
    // src/lib/legacyImport/) — Admin-SDK-only, same as the matching
    // infrastructure above. The claim/accept-terms API routes (which DO
    // run on behalf of an authenticated member) always use the Admin SDK
    // server-side, never the client SDK, so this rule never needs to
    // grant a client any access at all; it falls through to the
    // default-deny below on purpose.

    // Default-deny everything else.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
