BREVO_API_KEY=

# Firebase web app config (public/non-secret values from
# Firebase Console > Project settings > General > Your apps > Web app).
# Required for /introduction (Firebase Authentication + Firestore).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" only for local development against the Firebase
# Emulator Suite (see README). Never set this in production.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=
