BREVO_API_KEY=

# Firebase web app config (public/non-secret values from
# Firebase Console > Project settings > General > Your apps > Web app).
# Required for /introduction (Firebase Authentication + Firestore).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" only for local development against the Firebase
# Emulator Suite (see README). Never set this in production.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=

# Server-only. Used by /api/introduction/generate-presentation to call the
# Anthropic API. Never exposed to the browser. See README "AI presentation
# generation" for where to get a key and how it's configured in production.
ANTHROPIC_API_KEY=

# Server-only. Comma-separated list of the ONLY email addresses allowed to
# access /admin (the Admin Dashboard). Defaults to lara.dewavrin@gmail.com
# if unset. Never exposed to the browser — see README "Admin Dashboard".
ADMIN_ALLOWLIST_EMAILS=

# Server-only. Stripe TEST MODE secret key (starts with sk_test_). Used by
# /api/billing/* to create Checkout/Portal sessions and verify webhooks.
# See README "Stripe membership billing".
STRIPE_SECRET_KEY=

# Server-only. Signing secret for the /api/billing/webhook endpoint —
# obtained from the Stripe Dashboard when registering the endpoint, or
# printed by `stripe listen --forward-to localhost:3000/api/billing/webhook`
# for local testing.
STRIPE_WEBHOOK_SECRET=

# Server-only. The three sellable plans' Stripe Price IDs (TEST MODE).
# Never a Price ID or amount from the client — see src/lib/stripe/plans.ts.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_THREE_MONTH=
STRIPE_PRICE_SIX_MONTH=
