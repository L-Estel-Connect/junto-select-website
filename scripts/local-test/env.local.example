# Copy to .env.local for local testing. Every value here is fake or local:
# Firebase emulators, a demo- project that cannot exist in the cloud,
# and the local Stripe/Brevo stand-in. Never put real keys in this file.
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-junto-select.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-junto-select
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-junto-select.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:local
GCLOUD_PROJECT=demo-junto-select
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

APP_BASE_URL=http://localhost:3000
ADMIN_ALLOWLIST_EMAILS=admin.local@example.test

BREVO_API_KEY=local-test-not-a-real-key
BREVO_API_BASE_URL=http://127.0.0.1:12111/v3
BREVO_COMMUNITY_LIST_ID=999
BREVO_SENDER_NAME="Junto Select local"
BREVO_SENDER_EMAIL=local@example.test

STRIPE_SECRET_KEY=sk_test_local_mock
STRIPE_WEBHOOK_SECRET=whsec_local_test
STRIPE_LOCAL_MOCK_URL=http://127.0.0.1:12111
STRIPE_PRICE_MONTHLY=price_test_monthly
STRIPE_PRICE_THREE_MONTH=price_test_three_month
STRIPE_PRICE_SIX_MONTH=price_test_six_month
